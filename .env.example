# ScamShield Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./scamshield.db

# External API Intelligence Keys (Optional for local testing, required for live VirusTotal/URLScan scans)
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=

# URLScan Visibility: public, unlisted, private (default: unlisted for privacy)
URLSCAN_VISIBILITY=unlisted
